# Dependencies
node_modules/
backend/node_modules/

# Production build outputs
dist/
dist-ssr/
build/

# Environment variables & secrets (NEVER commit secrets to GitHub)
.env
.env.local
.env.*.local
backend/.env
backend/.env.local

# Backend user uploads & data (keep directory structure via .gitkeep)
backend/uploads/trees/*
!backend/uploads/trees/.gitkeep
backend/data/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS metadata files
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor files
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary files & caches
.cache/
.vite/
*.tmp
*.bak
