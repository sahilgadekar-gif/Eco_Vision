# ─── EcoVision Backend Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Option 1: Local MongoDB
MONGO_URI=mongodb://localhost:27017/ecovision

# Option 2: MongoDB Atlas (uncomment and replace with your URI)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecovision?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random secret in production!
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ecovision_super_secret_jwt_key_change_in_production_2025
JWT_EXPIRE=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
